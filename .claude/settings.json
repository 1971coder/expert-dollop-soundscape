{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(./scripts/check.sh:*)",
      "Bash(./scripts/test.sh:*)",
      "Bash(./scripts/format.sh:*)",
      "Bash(git fetch:*)",
      "Bash(git check-ignore:*)",
      "Bash(./scripts/template-audit.sh:*)",
      "Bash(./.claude/hooks/deny-dangerous-commands.test.sh)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/deny-dangerous-commands.sh"
          }
        ]
      }
    ]
  }
}
