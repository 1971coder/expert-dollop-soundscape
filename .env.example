# AuralFlow — environment variable template.
#
# Copy to .env (gitignored) and fill in values for local development.
# Convention: SCREAMING_SNAKE_CASE, AURALFLOW_ prefix (coding-standards §9).
# Secrets never get committed. Production builds inject values via the
# build-time script described in WP04 — Phase 4 (AI personalisation).
#
# All variables below are OPTIONAL until Phase 4. The app must build and
# run with none of them set.

# ── Phase 4 — natural-language preset adjuster (cloud-LLM, opt-in) ────────────
# OpenAI key used only when the NLP feature flag is enabled. Never read from
# the audio render path.
AURALFLOW_OPENAI_KEY=

# Anthropic / Claude key — used as an alternative provider for the NLP
# preset adjuster. Either OPENAI or ANTHROPIC is sufficient; both are not
# required.
AURALFLOW_ANTHROPIC_KEY=
